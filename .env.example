# Backend origin for the /api/* rewrite (server-side only, never sent to the browser).
# Local: the FastAPI dev server from backend/scripts/dev.sh
BACKEND_URL=http://localhost:8000

# Pyodide CDN base (must match harness/requirements.txt versions in the backend repo)
NEXT_PUBLIC_PYODIDE_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/

# Harness source for scripts/sync-harness.mjs when ../backend/harness is not present (CI/Vercel).
# Override the local path if your backend checkout lives elsewhere.
HARNESS_LOCAL_PATH=../backend/harness
